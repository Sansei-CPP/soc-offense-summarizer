# Copy to .env and adjust as needed. All variables are optional; defaults shown.
# The service reads these from the environment (see soc_summarizer/config.py).

# --- Ollama connection ---
OLLAMA_HOST=http://localhost:11434

# --- Models (must be pulled in Ollama: `ollama pull <model>`) ---
SOC_LLM_MODEL=qwen2.5:14b
SOC_EMBEDDING_MODEL=nomic-embed-text

# --- Knowledge base ---
# Defaults to ./data/knowledge_base relative to the repo root.
# SOC_KB_DIR=/absolute/path/to/knowledge_base

# --- Chunking (characters) ---
SOC_CHUNK_SIZE=800
SOC_CHUNK_OVERLAP=120

# --- Retrieval ---
SOC_TOP_K=4

# --- Generation ---
SOC_TEMPERATURE=0.1
SOC_NUM_CTX=8192
SOC_REQUEST_TIMEOUT=180
